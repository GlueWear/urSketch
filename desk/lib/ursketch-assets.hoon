7],[\27#f5bb1c\27,\27Gold\27],[\27#f50c08\27,\27Red\27],[\27#6c1dd1\27,\27Violet\27],[\27#7e043f\27,\27Maroon\27],[\27#490007\27,\27Dark brown\27],[\27#000000\27,\27Black\27],\0a  [\27#139cec\27,\27Azure\27],[\27#02a005\27,\27Green\27],[\27#f5f229\27,\27Yellow\27],[\27#e53f29\27,\27Orange-red\27],[\27#cb0069\27,\27Magenta\27],[\27#e0ba96\27,\27Peach\27],[\27#883e31\27,\27Brown\27],[\27#828280\27,\27Gray\27],\0a  [\27#8cbaee\27,\27Light blue\27],[\27#02f102\27,\27Lime\27],[\27#fffa85\27,\27Light yellow\27],[\27#fe9c3b\27,\27Orange\27],[\27#e67287\27,\27Pink\27],[\27#f3ccbd\27,\27Light peach\27],[\27#ba7b58\27,\27Tan\27],[\27#ffffff\27,\27White\27]\0a];\0afunction toast(message) { $(\27toast\27).textContent = message; $(\27toast\27).hidden = false; clearTimeout(toast.timer); toast.timer = setTimeout(() => $(\27toast\27).hidden = true, 4500); }\0afunction connection(text, good) { $(\27status\27).textContent = text; $(\27status-dot\27).classList.toggle(\27connected\27, good); connectionReady = good; }\0afunction element(tag, className, text) { const el = document.createElement(tag); if (className) el.className = className; if (text != null) el.textContent = text; return el; }\0aclass Eyre {\0a  constructor(){this.uid=`${Date.now()}-${crypto.randomUUID()}`;this.next=1;this.handlers=new Map();this.subscriptions=new Map();this.waiters=new Map();this.requests=new Map();this.url=`/~/channel/ursketch-${this.uid}`;this.opening=null;}\0a  async send(action){const id=this.next++;const response=await fetch(this.url,{method:\27PUT\27,headers:{\27Content-Type\27:\27application/json\27},body:JSON.stringify([{id,...action}]),signal:AbortSignal.timeout(15000)});if(!response.ok)throw new Error(response.status===403?\27Log into your ship, then reload this page.\27:`Your ship returned HTTP ${response.status}.`);return id;}\0a  ensure(){if(this.events&&this.events.readyState!==EventSource.CLOSED)return Promise.resolve();if(this.opening)return this.opening;this.opening=this.open().finally(()=>this.opening=null);return this.opening;}\0a  async open(){\0a    await this.send({action:\27poke\27,ship:SELF.slice(1),app:\27hood\27,mark:\27helm-hi\27,json:\27urSketch connected\27});\0a    this.events=new EventSource(this.url);\0a    this.events.onopen=()=>connection(`Connected as ${SELF}`,true);\0a    this.events.onerror=()=>connection(\27Reconnecting to your ship\e2\80\a6\27,false);\0a    this.events.onmessage=event=>{\0a      const data=JSON.parse(event.data);\0a      this.send({action:\27ack\27,\27event-id\27:Number(event.lastEventId)}).catch(()=>{});\0a      const subscription=this.subscriptions.get(data.id);\0a      if(data.response===\27diff\27){\0a        try{const ready=this.handlers.get(data.id)?.(data.json);if(ready!==false)subscription?.ready();}catch(e){subscription?.fail(e);}\0a      }\0a      if((data.response===\27subscribe\27&&data.err)||data.response===\27quit\27){\0a        const message=new Error(data.err?\27The host could not open that room or room list.\27:\27The host stopped sending updates.\27);\0a        subscription?.fail(message);\0a        if(subscription?.settled&&data.response===\27quit\27)subscriptionLost(data.id,message);\0a      }\0a      const waiter=this.waiters.get(data.id);\0a      if(waiter&&data.response===\27poke\27){\0a        if(waiter.remote&&!data.err)return;\0a        this.finish(waiter,data.err?new Error(\27The host rejected that action. Check the room and your role.\27):null);\0a      }\0a    };\0a    await this.subscribe(\27/relay\27,data=>{const waiter=this.requests.get(data.request);if(waiter)this.finish(waiter,data.ok?null:new Error(\27The host rejected that action. Check the room and your role.\27));},false,SELF);\0a  }\0a  finish(waiter,error){clearTimeout(waiter.timer);this.waiters.delete(waiter.id);this.requests.delete(waiter.request);error?waiter.reject(error):waiter.resolve();}\0a  poke(action,data={},target={host,room:roomId}){\0a    const id=this.next,request=`${this.uid}-${id}`;\0a    const result=new Promise((resolve,reject)=>{\0a      const waiter={id,request,resolve,reject,remote:target.host!==SELF};\0a      waiter.timer=setTimeout(()=>this.finish(waiter,new Error(\27The host did not respond. You can try again.\27)),20000);\0a      this.waiters.set(id,waiter);if(waiter.remote)this.requests.set(request,waiter);\0a      this.send({action:\27poke\27,ship:SELF.slice(1),app:\27ursketch\27,mark:\27json\27,json:{action,room:target.room,host:target.host,request,name:activeName,token:state?.token||0,...data}}).catch(e=>this.finish(waiter,e));\0a    });\0a    return result;\0a  }\0a  subscribe(path,handler,initial=false,targetHost=host){\0a    const id=this.next,localPath=targetHost===SELF?path:`/proxy/${targetHost}${path}`;\0a    let resolve,reject;\0a    const first=initial?new Promise((yes,no)=>{resolve=yes;reject=no;}):null;\0a    const meta={settled:!initial,ready:()=>{if(meta.settled)return;meta.settled=true;clearTimeout(meta.timer);resolve(id);},fail:e=>{if(meta.settled)return;meta.settled=true;clearTimeout(meta.timer);this.handlers.delete(id);this.subscriptions.delete(id);this.send({action:\27unsubscribe\27,subscription:id}).catch(()=>{});reject(e);}};\0a    if(initial)meta.timer=setTimeout(()=>meta.fail(new Error(\27No room data arrived from the host. Please try again.\27)),20000);\0a    this.handlers.set(id,handler);this.subscriptions.set(id,meta);\0a    const sent=this.send({action:\27subscribe\27,ship:SELF.slice(1),app:\27ursketch\27,path:localPath});\0a    if(initial){sent.catch(meta.fail);return first;}\0a    return sent.then(()=>id).catch(e=>{this.handlers.delete(id);this.subscriptions.delete(id);throw e;});\0a  }\0a  async unsubscribe(id){if(id==null)return;const sub=this.subscriptions.get(id);if(sub&&!sub.settled)sub.fail(new Error(\27Search cancelled.\27));this.handlers.delete(id);this.subscriptions.delete(id);await this.send({action:\27unsubscribe\27,subscription:id});}\0a}\0aconst api=new Eyre();\0aconst recoveryKey=`ursketch.room.${SELF}`,GRACE_MS=120000;\0alet savedRoom=null,browsing=false,joining=false,searchEpoch=0,roomEpoch=0;\0alet heartbeatInFlight=null,hostPresenceUntil=0,heartbeatWarning=false;\0alet roomStream=false,snapshotRequest=null;\0alet searchMode=\27host\27;\0aconst searchDrafts={host:SELF,invite:\27\27};\0afunction setSearchMode(mode){\0a  searchDrafts[searchMode]=$(\27host\27).value;searchMode=mode;\0a  const invite=mode===\27invite\27;\0a  for(const [id,active] of [[\27search-host-mode\27,!invite],[\27search-invite-mode\27,invite]]){const tab=$(id);tab.setAttribute(\27aria-selected\27,String(active));tab.tabIndex=active?0:-1;}\0a  $(\27host-form\27).setAttribute(\27aria-labelledby\27,invite?\27search-invite-mode\27:\27search-host-mode\27);\0a  $(\27search-label\27).textContent=invite?\27Room invite code\27:\27Browse a host ship\27;\0a  $(\27host\27).placeholder=invite?\27Paste your room invite code or link\27:\27~sampel-palnet\27;\0a  $(\27host\27).value=searchDrafts[mode];\0a}\0a$(\27search-host-mode\27).onclick=()=>setSearchMode(\27host\27);$(\27search-invite-mode\27).onclick=()=>setSearchMode(\27invite\27);\0afor(const id of [\27search-host-mode\27,\27search-invite-mode\27])$(id).onkeydown=event=>{if([\27ArrowLeft\27,\27ArrowRight\27,\27Home\27,\27End\27].includes(event.key)){event.preventDefault();const mode=event.key===\27Home\27?\27host\27:event.key===\27End\27?\27invite\27:searchMode===\27host\27?\27invite\27:\27host\27;setSearchMode(mode);$(mode===\27host\27?\27search-host-mode\27:\27search-invite-mode\27).focus();}};\0afunction operation(id,text,busy=false){const el=$(id);el.textContent=text;el.classList.toggle(\27is-busy\27,busy);el.setAttribute(\27aria-label\27,text+(busy?\27\e2\80\a6\27:\27\27));}\0afunction busyControls(){const busy=browsing||joining;$(\27host-search\27).disabled=busy;$(\27host\27).disabled=joining;$(\27search-host-mode\27).disabled=busy;$(\27search-invite-mode\27).disabled=busy;$(\27create-open\27).disabled=busy||host!==SELF;for(const b of $(\27room-list\27).querySelectorAll(\27button\27))b.disabled=busy||b.dataset.full===\27true\27;$(\27rejoin-room\27).disabled=busy;$(\27leave-saved-room\27).disabled=busy;}\0afunction saveRecovery(record){savedRoom=record;try{record?localStorage.setItem(recoveryKey,JSON.stringify(record)):localStorage.removeItem(recoveryKey);}catch{}renderRecovery();}\0afunction rememberRoom(title){if(!roomId)return;saveRecovery({host,id:roomId,title:title||state?.title||savedRoom?.title||roomId,expiresAt:Date.now()+GRACE_MS});}\0afunction renderRecovery(){const visible=!!savedRoom&&!state;$(\27room-recovery\27).hidden=!visible;if(!visible)return;const seconds=Math.max(0,Math.ceil((savedRoom.expiresAt-Date.now())/1000));$(\27recovery-title\27).textContent=savedRoom.title;$(\27recovery-detail\27).textContent=`On ${savedRoom.host} \c2\b7 Rejoin available for ${Math.floor(seconds/60)}:${String(seconds%60).padStart(2,\270\27)}`;}\0afunction restoreRecovery(){savedRoom=null;try{const r=JSON.parse(localStorage.getItem(recoveryKey)||\27null\27);if(r&&/^~[a-z-]+$/.test(r.host)&&/^[a-z0-9-]{1,40}$/.test(r.id)&&Number.isFinite(r.expiresAt))savedRoom=r;}catch{}renderRecovery();}\0afunction showLobby({keepRoom=true}={}){const old=roomSub;roomEpoch++;if(snapshotRequest){clearTimeout(snapshotRequest.timer);snapshotRequest=null;}roomId=\27\27;state=null;roomSub=null;if(old!=null)api.unsubscribe(old).catch(()=>{});drawing?.cancel();$(\27game\27).hidden=true;$(\27lobby\27).hidden=false;document.body.classList.remove(\27playing\27,\27is-artist\27,\27is-guesser\27);history.replaceState(null,\27\27,location.pathname);if(!keepRoom)saveRecovery(null);renderRecovery();}\0afunction subscriptionLost(id,error){if(id===roomSub){showLobby();operation(\27join-status\27,`${error.message} Use Rejoin to return.`);toast(\27Room connection lost. Your place is held for up to two minutes.\27);}else if(id===lobbySub){operation(\27browse-status\27,\27Room search disconnected. Search again to retry.\27);}}\0aasync function browse(ship){\0a  if(!/^~[a-z-]+$/.test(ship))throw new Error(\27Enter an Urbit ship name beginning with ~.\27);\0a  if(roomId)throw new Error(\27Leave your current room before searching another host.\27);\0a  const epoch=++searchEpoch;browsing=true;host=ship;searchDrafts.host=ship;if(searchMode===\27host\27)$(\27host\27).value=ship;\0a  operation(\27browse-status\27,`Browsing ${ship}`,true);operation(\27join-status\27,\27\27);listedRooms=[];renderRoomList();busyControls();\0a  try{\0a    await api.ensure();await api.unsubscribe(lobbySub);lobbySub=null;\0a    const id=await api.subscribe(\27/lobby\27,data=>{if(epoch===searchEpoch){if(data.kind!==\27lobby\27)throw new Error(\27The host did not return a room list.\27);renderLobby(data);}},true,ship);\0a    if(epoch!==searchEpoch){await api.unsubscribe(id);return;}\0a    lobbySub=id;\0a  }catch(e){if(epoch===searchEpoch)operation(\27browse-status\27,`Search failed: ${e.message}`);throw e;}\0a  finally{if(epoch===searchEpoch){browsing=false;busyControls();}}\0a}\0alet listedRooms=[];\0afunction renderRoomList(){renderRoomCards(listedRooms);}\0afunction renderLobby(data){\0a  if(data.kind!==\27lobby\27)return;\0a  operation(\27browse-status\27,data.rooms.length?`Found ${data.rooms.length} room${data.rooms.length===1?\27\27:\27s\27} on ${host}.`:`No rooms found on ${host}.`);\0a  listedRooms=data.rooms;renderRoomList();\0a}\0afunction renderRoomCards(rooms){\0a  const list=$(\27room-list\27);\0a  list.hidden=!rooms.length;\0a  if(!rooms.length){list.replaceChildren();return;}\0a  list.replaceChildren(...rooms.map(r=>{const card=element(\27article\27,\27room-card\27);card.append(element(\27p\27,\27eyebrow\27,r.phase.toUpperCase()),element(\27h3\27,\27\27,r.title));const bottom=element(\27div\27,\27card-bottom\27);bottom.append(element(\27span\27,\27\27,`${r.count} / 12 players`));const rejoin=savedRoom?.host===host&&savedRoom?.id===r.id;const full=r.count>=12&&!rejoin;const button=element(\27button\27,\27\27,rejoin?\27Rejoin \e2\86\92\27:full?\27Room full\27:\27Join room \e2\86\92\27);button.dataset.full=String(full);button.disabled=full||browsing||joining;button.onclick=()=>run(()=>joinRoom(r.id,r.title));bottom.append(button);card.append(bottom);return card;}));\0a}\0afunction requestDrawingSnapshot(){\0a  if(snapshotRequest?.epoch===roomEpoch)return;\0a  const epoch=roomEpoch;\0a  const request={epoch,timer:setTimeout(()=>{if(snapshotRequest===request){snapshotRequest=null;toast(\27Drawing updates are delayed. Rejoin if the connection does not recover.\27);}},20000)};\0a  snapshotRequest=request;\0a  api.poke(\27sync\27).catch(e=>{if(snapshotRequest===request){clearTimeout(request.timer);snapshotRequest=null;toast(e.message);}});\0a}\0afunction roomEvent(data){\0a  if(data.kind===\27draw\27){\0a    if(!state){requestDrawingSnapshot();return null;}\0a    if(data.token<state.token)return null;\0a    if(data.token!==state.token){requestDrawingSnapshot();return null;}\0a    if(data.count<=state.lines.length)return null;\0a    if(data.from!==state.lines.length||data.count!==data.from+data.lines.length){requestDrawingSnapshot();return null;}\0a    state.lines.push(...data.lines.map(l=>UrSketchWire.unpack(l)));state.count=data.count;state.seconds=data.seconds;\0a    clockSeconds=data.seconds;clockAt=performance.now();\0a    drawing.render(state.lines,state.token);updateDial();\0a    return null;\0a  }\0a  if(data.kind===\27state\27){\0a    if(state&&data.token===state.token&&data.count===state.lines.length)return {...data,kind:\27room\27,lines:state.lines};\0a    if(data.count===0)return {...data,kind:\27room\27,lines:[]};\0a    requestDrawingSnapshot();return null;\0a  }\0a  if(data.kind===\27room\27){\0a    if(snapshotRequest){clearTimeout(snapshotRequest.timer);snapshotRequest=null;}\0a    return {...data,lines:data.encoding===1?data.lines.map(l=>UrSketchWire.unpack(l)):data.lines};\0a  }\0a  return data;\0a}\0aasync function joinRoom(id,title=\27\27){\0a  if(joining)throw new Error(\27A room is already opening.\27);\0a  const epoch=++roomEpoch;let firstView=true;\0a  joining=true;roomId=id;state=null;operation(\27join-status\27,`Joining ${title||id}`,true);busyControls();\0a  let accepted=false;\0a  try{\0a    await api.ensure();await api.poke(\27join\27);accepted=true;hostPresenceUntil=Date.now()+GRACE_MS;heartbeatWarning=false;rememberRoom(title);\0a    await api.unsubscribe(roomSub);roomSub=null;\0a    const receive=data=>{\0a      if(epoch!==roomEpoch)return false;\0a      data=roomEvent(data);if(!data)return false;\0a      if(data.kind===\27removed\27||(data.kind===\27room\27&&!data.players.some(p=>p.ship===SELF))){saveRecovery(null);if(firstView)throw new Error(\27That room is no longer available.\27);localLeave();operation(\27join-status\27,\27Your place in that room has ended.\27);return false;}\0a      if(data.kind!==\27room\27)throw new Error(\27The host did not return a room.\27);\0a      firstView=false;renderRoom(data);return true;\0a    };\0a    roomStream=true;\0a    try{roomSub=await api.subscribe(`/stream/${id}/${SELF}`,receive,true);}\0a    catch(e){\0a      if(!/host could not open|host stopped sending/.test(e.message))throw e;\0a      roomStream=false;\0a      roomSub=await api.subscribe(`/room/${id}/${SELF}`,receive,true);\0a    }\0a    $(\27lobby\27).hidden=true;$(\27game\27).hidden=false;$(\27room-host\27).textContent=`HOSTED BY ${host.toUpperCase()}`;\0a    document.body.classList.add(\27playing\27);requestAnimationFrame(fitCanvas);history.replaceState(null,\27\27,`?host=${encodeURIComponent(host)}&room=${id}`);\0a    rememberRoom(state.title);operation(\27join-status\27,\27\27);\0a  }catch(e){showLobby({keepRoom:accepted||!!savedRoom});operation(\27join-status\27,`Could not join: ${e.message}`);throw e;}\0a  finally{joining=false;busyControls();}\0a}\0aasync function leaveSavedRoom(){const record=savedRoom;if(!record)return;joining=true;operation(\27join-status\27,\27Leaving room\27,true);busyControls();try{await api.ensure();await api.poke(\27leave\27,{}, {host:record.host,room:record.id});}catch{}finally{saveRecovery(null);joining=false;operation(\27join-status\27,\27Room left.\27);busyControls();}}\0a$(\27rejoin-room\27).onclick=()=>run(async()=>{const record=savedRoom;if(!record)return;await browse(record.host);await joinRoom(record.id,record.title);});\0a$(\27leave-saved-room\27).onclick=()=>run(leaveSavedRoom);\0asetInterval(()=>{if(state)return;if(savedRoom&&savedRoom.expiresAt<=Date.now()){saveRecovery(null);operation(\27join-status\27,\27Your two-minute rejoin window has ended.\27);}renderRecovery();},1000);\0a// Only the host expires membership. A stale lobby tab must never evict an active tab.\0awindow.addEventListener(\27storage\27,event=>{if(event.key===recoveryKey&&!state){restoreRecovery();renderRoomList();}});\0aasync function maintainPresence(){\0a  if(!state||!roomId||!connectionReady||heartbeatInFlight?.epoch===roomEpoch)return;\0a  const current={host,room:roomId},epoch=roomEpoch;\0a  heartbeatInFlight={epoch};\0a  try{\0a    await api.poke(\27heartbeat\27,{},current);\0a    if(epoch!==roomEpoch)return;\0a    hostPresenceUntil=Date.now()+GRACE_MS;rememberRoom(state.title);\0a    if(heartbeatWarning)toast(\27Room connection restored.\27);\0a    heartbeatWarning=false;\0a  }catch(e){\0a    if(epoch!==roomEpoch)return;\0a    if(Date.now()>=hostPresenceUntil){showLobby();operation(\27join-status\27,`${e.message} Use Rejoin to return.`);}\0a    else if(!heartbeatWarning){heartbeatWarning=true;toast(\27The host is slow to respond. Retrying your room connection\e2\80\a6\27);}\0a  }finally{if(heartbeatInFlight?.epoch===epoch)heartbeatInFlight=null;}\0a}\0asetInterval(()=>{void maintainPresence();},10000);\0adocument.addEventListener(\27visibilitychange\27,()=>{if(!document.hidden)void maintainPresence();});\0awindow.addEventListener(\27pagehide\27,()=>{const actions=[];if(state&&roomId){rememberRoom(state.title);actions.push({id:api.next++,action:\27poke\27,ship:SELF.slice(1),app:\27u