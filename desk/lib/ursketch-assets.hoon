tatus.is-busy::after{animation:none}}\0a\0a/* One search field with host and invite modes. */\0a.room-search{gap:18px}.search-modes{display:flex;gap:3px;flex-wrap:wrap}.search-modes button{border-color:transparent;background:transparent;padding:8px 10px;color:var(--muted);font-size:12px}.search-modes button[aria-selected=true]{background:var(--white);border-color:var(--line);color:var(--green)}.room-search form{min-width:0}.room-search input{width:320px}\0a@media(max-width:900px){.room-search{align-items:stretch;flex-direction:column;gap:9px}.room-search form{display:flex}.room-search input{flex:1;width:100%}.search-modes button{font-size:11px}}\0a/* Round controls, persistent hints, and zoom recovery. */\0a.brand-logo{display:block;width:43px;height:43px;flex:none}body.playing .brand-logo{width:33px;height:33px}\0a.header-actions .settings-button{font-size:20px;line-height:1;padding:6px;width:31px}\0a.studio-toolbar{display:flex;align-items:center;flex-wrap:wrap;gap:6px;flex:none;padding:5px 7px;background:#eef0e7;border-bottom:1px solid var(--line);min-width:0}\0a#round-controls{display:flex;gap:3px;align-items:center;flex:none;margin-right:auto}#round-controls button{padding:7px;font-size:10px;white-space:nowrap}#hints-used{font:9px monospace;display:block;margin-top:3px}\0a.studio-toolbar #tools{padding:0;border:0;min-height:0;flex:1;min-width:0;gap:4px}.studio-toolbar #drawing-palettes{gap:5px}\0a.hint-display{display:flex;align-items:center;justify-content:center;gap:10px;flex:1 1 150px;padding:4px 6px;min-width:0}#hint-letters{font:600 13px monospace;white-space:pre-wrap;overflow-wrap:anywhere}#hint-length{font-size:10px;color:var(--muted);white-space:nowrap}\0a.settings-heading{display:flex;justify-content:space-between;align-items:center;gap:15px}.settings-heading h2{margin:0}.settings-heading button{font-size:18px}\0a#settings-dialog{width:440px;max-height:calc(100dvh - 30px);overflow-y:auto;padding:22px}#settings-dialog fieldset{border:1px solid var(--lin