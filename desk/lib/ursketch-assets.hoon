  }\0a  async function setOutput(id){\0a    if(!audio.setSinkId){prefs.output=\27\27;save();return;}\0a    await audio.setSinkId(id);prefs.output=id;save();$(\27audio-output\27).value=id;message(\27Audio output selected. Use Test sound to check it.\27);\0a  }\0a  $(\27settings-open\27).onclick=()=>{$(\27settings-dialog\27).showModal();void outputs();};\0a  $(\27settings-close\27).onclick=()=>$(\27settings-dialog\27).close();\0a  $(\27theme-select\27).onchange=e=>{prefs.theme=e.target.value;save();};\0a  $(\27sound-volume\27).oninput=e=>{prefs.volume=Number(e.target.value);save();};\0a  for(const [id,name] of [[\27sound-muted\27,\27muted\27],[\27reduce-motion\27,\27reduceMotion\27],[\27large-chat\27,\27largeChat\27]])$(id).onchange=e=>{prefs[name]=e.target.checked;save();};\0a  $(\27audio-output\27).onchange=e=>{const id=e.target.value;setOutput(id).catch(()=>{$(\27audio-output\27).value=prefs.output;message(\27Could not switch to that output. Choose another device or system default.\27);});};\0a  $(\27choose-output\27).onclick=async()=>{\0a    try{\0a      if(navigator.mediaDevices?.selectAudioOutput){const device=await navigator.mediaDevices.selectAudioOutput(prefs.output?{deviceId:prefs.output}:{});await setOutput(device.deviceId);await outputs();}\0a      else await outputs();\0a    }catch(e){message(e.name===\27NotAllowedError\27?\27Output selection was cancelled or not permitted. System default is available.\27:\27The device could not be selected. Try again or use system default.\27);}\0a  };\0a  function tone(){\0a    if(toneUrl)return toneUrl;\0a    const rate=22050,count=Math.floor(rate*.24),buffer=new ArrayBuffer(44+count*2),v=new DataView(buffer);\0a    const text=(at,s)=>{for(let i=0;i<s.length;i++)v.setUint8(at+i,s.charCodeAt(i));};\0a    text(0,\27RIFF\27);v.setUint32(4,36+count*2,true);text(8,\27WAVE\27);text(12,\27fmt \27);v.setUint32(16,16,true);v.setUint16(20,1,true);v.setUint16(22,1,true);v.setUint32(24,rate,true);v.setUint32(28,rate*2,true);v.setU