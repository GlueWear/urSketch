ss\27).value.trim();if(!text||state?.phase!==\27drawing\27)return;run(async()=>{await api.poke(\27guess\27,{text});$(\27guess\27).value=\27\27;});};\0a$(\27chat-form\27).onsubmit=event=>{event.preventDefault();const text=$(\27chat-input\27).value.trim();if(!text)return;run(async()=>{await api.poke(\27chat\27,{text});$(\27chat-input\27).value=\27\27;});};\0a$(\27host-form\27).onsubmit=event=>{event.preventDefault();run(async()=>{\0a  const value=$(\27host\27).value.trim();searchDrafts[searchMode]=value;\0a  if(searchMode===\27host\27){await browse(value.toLowerCase());return;}\0a  let ship,id;\0a  const compact=value.match(/^(~[a-z-]+)\5c/(room-[a-z0-9-]+)$/i);\0a  if(compact){ship=compact[1].toLowerCase();id=compact[2].toLowerCase();}\0a  else{const invite=new URL(value,location.origin);ship=invite.searchParams.get(\27host\27)?.toLowerCase();id=invite.searchParams.get(\27room\27);}\0a  if(!ship||!id||!/^[a-z0-9-]{1,40}$/.test(id))throw new Error(\27Paste a room invite link or a code like ~sampel-palnet/room-abcd1234.\27);\0a  await browse(ship);await joinRoom(id);\0a});};\0a$(\27create-open\27).onclick=()=>$(\27create-dialog\27).showModal();$(\27cancel-create\27).onclick=()=>$(\27create-dialog\27).close();\0a$(\27create-form\27).onsubmit=event=>{event.preventDefault();run(async()=>{host=SELF;roomId=`room-${crypto.randomUUID().slice(0,8)}`;try{await api.poke(\27create\27,{title:$(\27title\27).value.trim()});await joinRoom(roomId);$(\27create-dialog\27).close();}catch(e){roomId=\27\27;throw e;}});};\0afunction localLeave(){showLobby({keepRoom:false});}\0a$(\27leave\27).onclick=()=>run(async()=>{await api.poke(\27leave\27);await api.unsubscribe(roomSub);localLeave();await browse(host);});\0a$(\27invite\27).onclick=()=>run(async()=>{const invite=`${location.origin}/apps/ursketch?host=${encodeURIComponent(host)}&room=${roomId}`;await navigator.clipboard.writeText(invite);toast(\27Invite copied. Friends can paste it into urSketch on their own ship.\27);});\0a$(\27help\27).onclick=()=>$(\27help-dialog\27).showModal();$(\27close-help\27).onclick=()=>$(\27help-dialog\27).close();\0afunction renderProfiles(){const select=$(\27profile-select\27);select.replaceChildren(...profiles.map(name=>{const option=element(\27option\27,\27\27,name);option.value=name;return option;}),new Option(\27New player\e2\80\a6\27,\27\27));select.value=profiles.includes(activeName)?activeName:\27\27;$(\27player-name\27).value=activeName===SELF?\27\27:activeName;$(\27profile-current\27).textContent=activeName===SELF?\27Choose the name your friends will see.\27:`Playing as ${activeName}`;$(\27profile-avatar\27).textContent=activeName===SELF?\27\e2\9c\8e\27:Array.from(activeName)[0].toUpperCase();}\0afunction rememberProfile(name){activeName=name;if(!profiles.includes(name))profiles.push(name);profiles=profiles.slice(-20);try{localStorage.setItem(profileKey,JSON.stringify({names:profiles,active:name}));}catch{}renderProfiles();}\0a$(\27profile-form\27).onsubmit=event=>{event.preventDefault();run(async()=>{const name=$(\27player-name\27).value.trim();if(!name)return;rememberProfile(name);if(host===SELF)await api.poke(\27profile\27);toast(`Player saved: ${name}`);});};\0a$(\27profile-select\27).onchange=()=>{const name=$(\27profile-select\27).value;if(name)rememberProfile(name);else{$(\27player-name\27).value=\27\27;$(\27player-name\27).focus();}};\0afunction installClassicScrollbars(){\0a  for(const id of [\27players\27,\27messages\27,\27chat-messages\27]){\0a    const content=$(id),shell=element(\27div\27,\27classic-scroll-shell\27),rail=element(\27div\27,\27classic-scrollbar\27);\0a    const up=element(\27button\27,\27scroll-up\27),track=element(\27div\27,\27scroll-track\27),thumb=element(\27div\27,\27scroll-thumb\27),down=element(\27button\27,\27scroll-down\27);\0a    up.type=down.type=\27button\27;up.setAttribute(\27aria-label\27,\27Scroll up\27);down.setAttribute(\27aria-label\27,\27Scroll down\27);\0a    thumb.tabIndex=0;thumb.setAttribute(\27role\27,\27scrollbar\27);thumb.setAttribute(\27aria-orientation\27,\27vertical\27);thumb.setAttribute(\27aria-controls\27,id);thumb.setAttribute(\27aria-valuemin\27,\270\27);\0a    content.before(shell);shell.append(content,rail);track.append(thumb);rail.append(up,track,down);\0a    function update(){\0a      if(!rail.offsetHeight)return;\0a      const max=Math.max(0,content.scrollHeight-content.clientHeight),size=Math.min(track.clientHeight,23);\0a      thumb.style.height=size+\27px\27;thumb.style.top=(max?(track.clientHeight-size)*content.scrollTop/max:0)+\27px\27;\0a      thumb.setAttribute(\27aria-valuemax\27,String(max));thumb.setAttribute(\27aria-valuenow\27,String(Math.round(content.scrollTop)));\0a    }\0a    let repeat=null;\0a    function stop(){clearInterval(repeat);repeat=null;}\0a    for(const [button,amount] of [[up,-17],[down,17]]){button.onclick=()=>{content.scrollTop+=amount;};button.onpointerdown=()=>{stop();repeat=setInterval(()=>{content.scrollTop+=amount;},80);};button.onpointerup=stop;button.onpointercancel=stop;button.onpointerleave=stop;}\0a    let drag=null;\0a    thumb.onpointerdown=e=>{e.preventDefault();thumb.focus({preventScroll:true});drag={y:e.clientY,top:content.scrollTop};thumb.setPointerCapture(e.pointerId);};\0a    thumb.onpointermove=e=>{if(!drag)return;const distance=Math.max(1,track.clientHeight-thumb.offsetHeight);content.scrollTop=drag.top+(e.clientY-drag.y)*(content.scrollHeight-content.clientHeight)/distance;};\0a    thumb.onpointerup=thumb.onpointercancel=thumb.onlostpointercapture=()=>{drag=null;};\0a    window.addEventListener(\27blur\27,()=>{stop();drag=null;});\0a    track.onpointerdown=e=>{if(e.target===track){content.scrollTop+=(e.clientY<thumb.getBoundingClientRect().top?-1:1)*content.clientHeight;}};\0a    thumb.onkeydown=e=>{const steps={ArrowUp:-17,ArrowDown:17,PageUp:-content.clientHeight,PageDown:content.clientHeight};if(e.key in steps){e.preventDefault();e.stopPropagation();content.scrollTop+=steps[e.key];}else if(e.key===\27Home\27||e.key===\27End\27){e.preventDefault();e.stopPropagation();content.scrollTop=e.key===\27Home\27?0:content.scrollHeight;}};\0a    content.addEventListener(\27scroll\27,update);new ResizeObserver(update).observe(content);new MutationObserver(update).observe(content,{childList:true,subtree:true,characterData:true});\0a  }\0a}\0afunction syncThemeLayout(){\0a  const classic=document.body.dataset.theme===\27classic\27;\0a  for(const [id,anchor] of [[\27guess-form\27,\27guess-form-home\27],[\27round-controls\27,\27round-controls-home\27]]){\0a    const target=classic?$(\27classic-left-controls\27):$(anchor).parentElement;\0a    if($(id).parentElement!==target){if(classic)target.append($(id));else $(anchor).after($(id));}\0a  }\0a}\0afunction fitCanvas(){const wrap=$(\27canvas\27).parentElement;if(!wrap.clientWidth||!wrap.clientHeight)return;const scale=Math.min(wrap.clientWidth/1000,wrap.clientHeight/700);$(\27canvas\27).style.width=`${Math.floor(1000*scale)}px`;$(\27canvas\27).style.height=`${Math.floor(700*scale)}px`;drawing?.fit();}\0anew ResizeObserver(fitCanvas).observe($(\27canvas\27).parentElement);\0atry{const saved=JSON.parse(localStorage.getItem(profileKey)||\27null\27);if(saved){profiles=(saved.names||[]).filter(n=>typeof n===\27string\27&&n.length<=24);if(profiles.includes(saved.active))activeName=saved.active;}}catch{}\0ainstallClassicScrollbars();\0aconst preferences=createSettings({notify:toast,onChange:()=>{syncThemeLayout();requestAnimationFrame(fitCanvas);}});\0arenderProfiles();drawing=createDrawing({canvas:$(\27canvas\27),colors,canDraw,send:(action,data)=>api.poke(action,action===\27draw\27&&roomStream?{encoding:1,lines:data.lines.map(l=>UrSketchWire.pack(l))}:data),error:e=>toast(e.message||String(e)),storageKey:`ursketch.palettes.${SELF}`});restoreRecovery();\0arun(async()=>{if(!SELF)throw new Error(\27Open urSketch through your Urbit ship at /apps/ursketch.\27);const query=new URLSearchParams(location.search);await browse(query.get(\27host\2