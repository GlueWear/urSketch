  (cat 3 '<!doctype html>\0a<html lang="en">\0a<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>urSketch \c2\b7 Draw together on Urbit</title><link rel="icon" type="image/svg+xml" sizes="any" href="data:image/svg+xml;base64,"><style>:root{--paper:#f7f7f0;--ink:#253e34;--muted:#758174;--green:#32684e;--line:#d7ddcf;--white:#fffef9;--soft:#e9eee5;font-family:Arial,Helvetica,sans-serif;color:var(--ink);background:var(--paper)}\0a*{box-sizing:border-box}body{margin:0}button,input,select{font:inherit}button,input,select,a{outline-offset:3px}button{cursor:pointer;border:1px solid var(--line);background:var(--white);color:var(--ink);border-radius:5px;padding:10px 14px;font-size:12px;font-weight:600}button:hover{background:var(--soft)}button:disabled{opacity:.45;cursor:default}.primary{background:var(--green);border-color:var(--green);color:white}.primary:hover{background:#24553d}.quiet{background:transparent;border-color:transparent}input,select{border:1px solid var(--line);border-radius:5px;background:var(--white);padding:10px;color:var(--ink);min-width:0}input:focus,select:focus{outline:2px solid #8aa78d}\0aheader{height:78px;max-width:1460px;margin:auto;padding:0 36px;display:flex;align-items:center;justify-content:space-between;gap:15px;border-bottom:1px solid var(--line);width:100%}.brand{display:flex;gap:10px;align-items:center;text-decoration:none;color:var(--ink);font-size:29px;font-weight:800;letter-spacing:-1px}.brand-mark{font:italic bold 32px Georgia,serif;width:39px;height:39px;text-align:center;line-height:39px;background:var(--green);color:var(--paper);border-radius:9px;transform:rotate(-6deg);position:relative}.brand-mark span{position:absolute;right:-7px;top:-12px;font-size:21px;color:#edc76b}.brand-tag{font:9px monospace;letter-spacing:1.5px;border:1px solid var(--line);padding:5px;border-radius:3px;margin-left:7px}.connection{display:flex;gap:7px;align-items:center;font:10px monospace;color:var(--muted